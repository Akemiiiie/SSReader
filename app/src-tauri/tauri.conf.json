{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SSReader",
  "version": "0.1.0",
  "identifier": "com.ssreader.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1421",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "SSReader", "width": 1280, "height": 800, "transparent": true, "visible": false, "decorations": false }]
  },
  "bundle": { "active": true, "targets": ["nsis", "msi"], "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"] }
}
